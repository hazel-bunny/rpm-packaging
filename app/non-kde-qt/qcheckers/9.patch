diff --git a/debian/control b/debian/control
index 368cd9e..780bb31 100644
--- a/debian/control
+++ b/debian/control
@@ -2,7 +2,7 @@ Source: qcheckers
 Section: games
 Priority: optional
 Maintainer: Ilya Portnov <portnov84@rambler.ru>
-Build-Depends: debhelper (>= 11), qt5-qmake-bin, qtbase5-dev, libqt5svg5-dev
+Build-Depends: debhelper (>= 9), qt5-qmake, qtbase5-dev, libqt5svg5-dev
 Standards-Version: 4.1.3
