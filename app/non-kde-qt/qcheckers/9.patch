From 0e8654265cc515ffff77692fcfdd6ef76ee7e5c5 Mon Sep 17 00:00:00 2001
From: Ilya Portnov <portnov@bk.ru>
Date: Tue, 20 Apr 2021 22:47:19 +0500
Subject: [PATCH 3/3] Add scripts to build on Arch && Qt6.

---
 Dockerfile.arch    | 12 ++++++++++++
 arch_entrypoint.sh |  6 ++++++
 build_on_arch.sh   | 11 +++++++++++
 3 files changed, 29 insertions(+)
 create mode 100644 Dockerfile.arch
 create mode 100755 arch_entrypoint.sh
 create mode 100755 build_on_arch.sh

diff --git a/Dockerfile.arch b/Dockerfile.arch
new file mode 100644
index 0000000..d568352
--- /dev/null
+++ b/Dockerfile.arch
@@ -0,0 +1,12 @@
+FROM archlinux
+MAINTAINER Ilya V. Portnov <portnov84@rambler.ru>
+
+RUN pacman -Sy && yes | pacman -S gcc make qt6-base qt6-svg qt6-tools icu
+
+VOLUME /dst
+VOLUME /src
+WORKDIR /src/qcheckers
+
+ADD arch_entrypoint.sh .
+
+CMD ["/bin/bash", "-c", "./arch_entrypoint.sh"]
diff --git a/arch_entrypoint.sh b/arch_entrypoint.sh
new file mode 100755
index 0000000..34d009d
--- /dev/null
+++ b/arch_entrypoint.sh
@@ -0,0 +1,6 @@
+#!/bin/bash
+
+set -e
+
+qmake6
+make
diff --git a/build_on_arch.sh b/build_on_arch.sh
new file mode 100755
index 0000000..c6a4d77
--- /dev/null
+++ b/build_on_arch.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+set -e
+
+rm -f Makefile src/Makefile
+qmake
+make clean
+rm -f Makefile src/Makefile
+
+docker build -t qcheckers-arch -f Dockerfile.arch .
+
+docker run --rm --name qcheckers-arch -v $(pwd):/src/qcheckers -v $(pwd):/dst qcheckers-arch
