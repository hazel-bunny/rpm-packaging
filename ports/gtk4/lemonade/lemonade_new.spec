# Generated by rust2rpm 26
%bcond_without check

# prevent library files from being installed
%global cargo_install_lib 0

Name:           lemonade

%global forgeurl https://github.com/theycallhermax/%{name}
%global commit 83d3b972d9a68027cdc6e0472a38f8927e2bb3b3
%global date 20240808
%forgemeta

%global app_id ml.mdwalters.Lemonade

Version:        2.0.0
Release:        1%{?dist}
Summary:        Follow discussions on Lemmy
License:        GPL-3.0
# LICENSE.dependencies contains a full license breakdown

URL:            %{forgeurl}
Source:         %{forgesource}

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  desktop-file-utils
BuildRequires:  gcc
BuildRequires:  gettext
BuildRequires:  glib2-devel
BuildRequires:  gtk-update-icon-cache
BuildRequires:  hicolor-icon-theme
BuildRequires:  just
BuildRequires:  libappstream-glib
BuildRequires:  meson
BuildRequires:  ninja-build
BuildRequires:  rust-just-devel

Requires:       gtk4
Requires:       libadwaita
Requires:       python3-certifi
Requires:       python3-charset-normalizer
Requires:       python3-gobject
Requires:       python3-idna
Requires:       python3-requests
Requires:       python3-urllib3

%global _description %{expand:
%{summary}.}

%description %{_description}

%prep
%forgeautosetup -p1
%cargo_prep

%generate_buildrequires
%cargo_generate_buildrequires

%build
just build-release
# %%cargo_build
# %%{cargo_license_summary}
# %%{cargo_license} > LICENSE.dependencies

%install
just rootdir=%{buildroot} install
# %%cargo_install

%if %{with check}
%check
%cargo_test
desktop-file-validate %{buildroot}%{_datadir}/applications/%{app_id}.desktop
appstream-util validate-relax --nonet %{buildroot}%{_datadir}/appdata/%{app_id}.appdata.xml
%endif

%files
%license licenses/GPL-3.0-or-later.txt
%license LICENSE.dependencies
%doc README.md
%{_bindir}/lemonade
%{_datadir}/%{name}
%{_datadir}/applications/%{app_id}.desktop
%{_datadir}/appdata/%{app_id}.appdata.xml
%{_datadir}/glib-2.0/schemas/%{app_id}.gschema.xml
%{_datadir}/icons/hicolor/{scalable,symbolic}/apps/%{app_id}*.svg

%changelog
%autochangelog
